@@ -0,0 +1,36 @@
+import unittest
+from unittest.mock import patch
+
+from src.config.settings import Settings
+
+
+class TestPriorityGamesMigration(unittest.TestCase):
+    """The legacy "games_to_watch" whitelist must migrate to "priority_games"."""
+
+    def _load_settings(self, stored: dict) -> Settings:
+        with patch("src.config.settings.json_load", return_value=dict(stored)):
+            return Settings()
+
+    def test_legacy_games_to_watch_becomes_priority_games(self):
+        settings = self._load_settings({"games_to_watch": ["Rust", "Fortnite"]})
+        self.assertEqual(settings.priority_games, ["Rust", "Fortnite"])
+        self.assertFalse(hasattr(settings, "games_to_watch"))
+
+    def test_existing_priority_games_wins_over_legacy_list(self):
+        settings = self._load_settings(
+            {"games_to_watch": ["Rust"], "priority_games": ["Warframe"]}
+        )
+        self.assertEqual(settings.priority_games, ["Warframe"])
+
+    def test_no_legacy_key_keeps_priority_games(self):
+        settings = self._load_settings({"priority_games": ["Warframe"]})
+        self.assertEqual(settings.priority_games, ["Warframe"])
+
+    def test_empty_legacy_list_is_ignored(self):
+        settings = self._load_settings({"games_to_watch": [], "priority_games": []})
+        self.assertEqual(settings.priority_games, [])
+        self.assertFalse(hasattr(settings, "games_to_watch"))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_stream_selector.py b/tests/test_stream_selector.py
new file mode 100644
index 0000000..93e71d8
--- /dev/null
+++ b/tests/test_stream_selector.py
@@ -0,0 +1,137 @@
+import unittest
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+from src.services.stream_selector import StreamSelector
+
+
+def make_game(name: str):
+    return SimpleNamespace(id=abs(hash(name)) % 10_000, name=name, box_art_url=f"{name}.png")
+
+
+class FakeDrop:
+    def __init__(self, claimed: bool = False, benefits: list | None = None):
+        self.name = "drop"
+        self.is_claimed = claimed
+        self._benefits = benefits if benefits is not None else [{"name": "benefit"}]
+
+    def get_wanted_unclaimed_benefits(self, mining_benefits):
+        return self._benefits
+
+
+class FakeCampaign:
+    _counter = 0
+
+    def __init__(
+        self,
+        game_name: str,
+        ends_in_hours: float = 24.0,
+        earnable: bool = True,
+        drops: list | None = None,
+    ):
+        FakeCampaign._counter += 1
+        self.id = f"campaign-{FakeCampaign._counter}"
+        self.name = f"{game_name} campaign"
+        self.campaign_url = f"https://example.com/{self.id}"
+        self.game = make_game(game_name)
+        self.ends_at = datetime.now(timezone.utc) + timedelta(hours=ends_in_hours)
+        self._earnable = earnable
+        self.drops = drops if drops is not None else [FakeDrop()]
+
+    def can_earn_within(self, stamp):
+        return self._earnable
+
+
+def make_settings(priority_games: list[str] | None = None):
+    return SimpleNamespace(priority_games=priority_games or [], mining_benefits={})
+
+
+class TestStreamSelector(unittest.TestCase):
+    def setUp(self):
+        self.selector = StreamSelector()
+
+    def test_all_games_mined_without_priority_list(self):
+        """Every game with an earnable campaign is included, even with no priority set."""
+        campaigns = [FakeCampaign("Rust"), FakeCampaign("Fortnite"), FakeCampaign("Warframe")]
+        games = self.selector.get_wanted_games(make_settings(), campaigns)
+        self.assertEqual({g.name for g in games}, {"Rust", "Fortnite", "Warframe"})
+
+    def test_priority_games_come_first_in_order(self):
+        campaigns = [
+            FakeCampaign("Rust", ends_in_hours=1),
+            FakeCampaign("Fortnite", ends_in_hours=2),
+            FakeCampaign("Warframe", ends_in_hours=3),
+        ]
+        settings = make_settings(priority_games=["Warframe", "Fortnite"])
+        games = self.selector.get_wanted_games(settings, campaigns)
+        self.assertEqual([g.name for g in games], ["Warframe", "Fortnite", "Rust"])
+
+    def test_non_priority_games_ordered_by_soonest_ending_campaign(self):
+        campaigns = [
+            FakeCampaign("Rust", ends_in_hours=100),
+            FakeCampaign("Fortnite", ends_in_hours=5),
+            FakeCampaign("Warframe", ends_in_hours=50),
+        ]
+        games = self.selector.get_wanted_games(make_settings(), campaigns)
+        self.assertEqual([g.name for g in games], ["Fortnite", "Warframe", "Rust"])
+
+    def test_priority_matching_is_case_insensitive(self):
+        campaigns = [FakeCampaign("Rust"), FakeCampaign("Fortnite")]
+        settings = make_settings(priority_games=["fortnite"])
+        games = self.selector.get_wanted_games(settings, campaigns)
+        self.assertEqual(games[0].name, "Fortnite")
+
+    def test_priority_games_without_campaigns_are_skipped(self):
+        campaigns = [FakeCampaign("Rust")]
+        settings = make_settings(priority_games=["Fortnite", "Rust"])
+        games = self.selector.get_wanted_games(settings, campaigns)
+        self.assertEqual([g.name for g in games], ["Rust"])
+
+    def test_non_earnable_campaigns_are_excluded(self):
+        campaigns = [FakeCampaign("Rust"), FakeCampaign("Fortnite", earnable=False)]
+        games = self.selector.get_wanted_games(make_settings(), campaigns)
+        self.assertEqual([g.name for g in games], ["Rust"])
+
+    def test_campaigns_with_only_claimed_drops_are_excluded(self):
+        campaigns = [
+            FakeCampaign("Rust", drops=[FakeDrop(claimed=True)]),
+            FakeCampaign("Fortnite"),
+        ]
+        games = self.selector.get_wanted_games(make_settings(), campaigns)
+        self.assertEqual([g.name for g in games], ["Fortnite"])
+
+    def test_campaigns_without_wanted_benefits_are_excluded(self):
+        campaigns = [
+            FakeCampaign("Rust", drops=[FakeDrop(benefits=[])]),
+            FakeCampaign("Fortnite"),
+        ]
+        games = self.selector.get_wanted_games(make_settings(), campaigns)
+        self.assertEqual([g.name for g in games], ["Fortnite"])
+
+    def test_multiple_campaigns_grouped_under_one_game(self):
+        campaigns = [
+            FakeCampaign("Rust", ends_in_hours=10),
+            FakeCampaign("Rust", ends_in_hours=1),
+            FakeCampaign("Fortnite", ends_in_hours=5),
+        ]
+        tree = self.selector.get_wanted_game_tree(make_settings(), campaigns)
+        self.assertEqual(len(tree), 2)
+        # Rust's soonest-ending campaign (1h) sorts it before Fortnite (5h)
+        self.assertEqual(tree[0]["game_name"], "Rust")
+        self.assertEqual(len(tree[0]["campaigns"]), 2)
+
+    def test_tree_entries_carry_campaign_details(self):
+        campaign = FakeCampaign("Rust")
+        tree = self.selector.get_wanted_game_tree(make_settings(), [campaign])
+        self.assertEqual(len(tree), 1)
+        entry = tree[0]["campaigns"][0]
+        self.assertEqual(entry["id"], campaign.id)
+        self.assertEqual(entry["name"], campaign.name)
+        self.assertEqual(entry["url"], campaign.campaign_url)
+        self.assertEqual(len(entry["drops"]), 1)
+        # the public tree omits the game object
+        self.assertIsNone(tree[0]["game_obj"])
+
+
+if __name__ == "__main__":
+    unittest.main()
