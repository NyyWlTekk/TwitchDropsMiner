//////////////////////////////////////////////////
//////////// HEADER FUNCTIONS & SOCKETS //////////
//////////////////////////////////////////////////

// --- SOCKET EVENT LISTENERS ---
socket.on('connect', handleConnect);
socket.on('disconnect', handleDisconnect);

function handleConnect() {
    console.log('[Socket] Connected to server');

    // 1. Zápis do globálního Single Source of Truth
    window.state = {
        ...window.state,
        connected: true
    };

    // 2. Aktualizace UI a vystřelení událostí
    updateConnectionStatus();
    window.dispatchEvent(new CustomEvent('app:socket-connected'));
    window.dispatchEvent(new CustomEvent('stateUpdated'));
}

function handleDisconnect(reason) {
    console.warn('[Socket] Disconnected from server:', reason);

    // 1. Zápis do globálního Single Source of Truth
    window.state = {
        ...window.state,
        connected: false
    };

    // 2. Aktualizace UI a vystřelení událostí
    updateConnectionStatus();
    window.dispatchEvent(new CustomEvent('app:socket-disconnected'));
    window.dispatchEvent(new CustomEvent('stateUpdated'));
}

//////////////////////////////////////////////////
///////////LISTENER///////////////////////////////
/////////////////////////////////////////////////

// 🎯 AUTOMATICKÁ REAKCE NA ZMĚNU GLOBÁLNÍHO STAVU
window.addEventListener('stateUpdated', () => {
    // Když dorazí nová data přes socket (handle_state), synchronizujeme UI statusu
    if (window.state?.status) {
        const statusEl = document.getElementById('status-text');
        if (statusEl && statusEl.textContent !== window.state.status) {
            statusEl.textContent = window.state.status;
        }
    }
    updateConnectionStatus();
});


//////////////////////////////////////////////////
///////// CONNECTION STATUS UI RENDER ////////////
//////////////////////////////////////////////////

/**
 * Vykreslí indikátory připojení na základě window.state
 */
function updateConnectionStatus(input = null) {
    // Čerpáme stav výhradně z window.state
    const isConnected = typeof input === 'boolean' 
        ? input 
        : Boolean(input?.connected ?? window.state?.connected);

    // Uložíme aktualizovaný stav připojení
    if (window.state) {
        window.state.connected = isConnected;
    }

    // A. Header Connection Indicator (#connection-indicator)
    const connIndicator = document.getElementById('connection-indicator');
    if (connIndicator) {
        const translations = window.currentTranslations || window.state?.translations;
        const statusLabel = isConnected 
            ? (translations?.gui?.websocket?.connected || 'Connected') 
            : (translations?.gui?.websocket?.disconnected || 'Disconnected');

        connIndicator.textContent = `● ${statusLabel}`;
        connIndicator.classList.toggle('connected', isConnected);
        connIndicator.classList.toggle('disconnected', !isConnected);
    }

    // B. Admin Panel & Diagnostics Indicator (#socket-status)
    const socketStatusEl = window.elements?.socketStatus || document.getElementById('socket-status');
    if (socketStatusEl) {
        socketStatusEl.textContent = isConnected ? 'Connected' : 'Disconnected';
        socketStatusEl.style.color = isConnected ? '#4caf50' : '#f44336';
    }

    // C. Diagnostika (z objektu nebo z window.state)
    const diagData = (typeof input === 'object' && input !== null) ? input : window.state?.diagnostics;
    if (diagData) {
        const queueCountEl = window.elements?.queueCount || document.getElementById('queue-count');
        if (queueCountEl && diagData.queueCount !== undefined) {
            queueCountEl.textContent = `${diagData.queueCount} campaigns`;
        }

        const rotationIndexEl = window.elements?.rotationIndex || document.getElementById('rotation-index');
        if (rotationIndexEl && diagData.rotationIndex !== undefined) {
            rotationIndexEl.textContent = diagData.rotationIndex;
        }
    }
}

// Global Access
window.updateConnectionStatus = updateConnectionStatus;

//////////////////////////////////////////////////
//////////////// STATUS BAR UI ///////////////////
//////////////////////////////////////////////////

/**
 * Handler pro samostatný příjem status události ze socketu
 */
function handleStatusUpdate(data) {
    if (!data || !data.status) return;
    updateStatus(data.status);
}

/**
 * Přímý zápis textu statusu do window.state a DOMu (#status-text)
 */
function updateStatus(status) {
    if (!status) return;

    // 1. Aktualizace Single Source of Truth
    if (window.state) {
        window.state.status = status;
    }

    // 2. Vykreslení do DOMu
    const statusEl = document.getElementById('status-text');
    if (statusEl && statusEl.textContent !== status) {
        statusEl.textContent = status;
    }

    // 3. Reakce na offline / idle stav
    const lower = status.toLowerCase();
    if (lower.includes('idle') || lower.includes('offline')) {
        if (typeof safeClearDrop === 'function') {
            safeClearDrop();
        }
    }

    // 4. Synchronizace s adminem
    if (typeof syncAdminState === 'function') {
        syncAdminState();
    }
}
