                    else if (drop.current_minutes > 0) in_progress_drops_count++;
                }

                // Výpočet minut pro filtr (pokud filtrujeme podle hry, kampaně nebo dropu)
                const isFilteredScope = (!game_id && !campaign_id && !drop_id) || isTargetGame || isTargetCampaign || isTargetDrop;
                if (isFilteredScope) {
