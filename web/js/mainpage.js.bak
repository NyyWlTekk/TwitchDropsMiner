            found_game = game;
            game_icon = game.game_icon || game.image_url;
            if (!campaign_id && !drop_id) {
                image_url = game_icon;
            }
        }

        for (const campaign of (game.campaigns || [])) {
            if (!campaign) continue;

            const isTargetCampaign = campaign_id && String(campaign.campaign_id) === String(campaign_id);

            // Součet celkového času za celou frontu
            total_remaining_minutes += Number(campaign.total_remaining_minutes) || 0;

            if (isTargetCampaign) {
                found_game = game;
                found_campaign = campaign;
                campaign_icon = campaign.campaign_icon || campaign.image_url || game.game_icon;
