///////////////////////////////////////////////////////////////////////////////////////
// MAIN PAGE --- MAIN LOGIC ////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

// 1. Odchytávání přicházejících dat z WebSocketu
socket.on('state', handle_state);

/**
 * Hlavní handler pro příjem a zpracování kompletního stavu aplikace
 */
function handle_state(data) {
    if (!data || typeof data !== 'object') {
        console.warn('⚠️ [State] Přijata neplatná nebo prázdná data ze serveru:', data);
        return;
    }

    const rawData = data;
//    console.log(`[${new Date().toLocaleTimeString()}] 📥 [State] Aktualizuji globální stav:`, rawData);

    const slugify = text => String(text || '').toLowerCase().replace(/[^a-z0-9]/g, '_');

    // 1. Získání základních proměnných z backendu
    const status = rawData.status ?? '';
    const currentDrop = rawData.current_drop ?? null;
    const watchingChannel = rawData.watching_channel ?? null;
    const channels = rawData.channels ?? {};
    const settings = rawData.settings ?? {};
    const manualMode = rawData.manual_mode ?? null;
    const activeGame = rawData.active_game ?? null;
    const rawCampaigns = rawData.campaigns || [];

    const watchedChannelObj = watchingChannel && channels[watchingChannel] ? channels[watchingChannel] : null;

    // 🎯 RESOLVE LOGIKA - PŘESNĚ PODLE ORIGINÁLNÍ STRUKTURY (benefits[0].image_url + ID match)
    const resolveDropImageUrl = (drop, parentCampId, parentCampIcon, parentGameIcon) => {
        if (!drop) return parentCampIcon || parentGameIcon || null;

        // 1. Přímé vytažení z benefits[0].image_url (nebo image_url / drop_icon)
        const directUrl = drop.benefits?.[0]?.image_url || drop.image_url || drop.drop_icon;
        if (directUrl) return directUrl;

        // 2. Pokud obrázek chybí, dohledáme v rawCampaigns přes ID kampaně a ID dropu
        const dropId = String(drop.id || drop.drop_id || '');
        const campaignId = String(drop.campaign_id || parentCampId || '');

        const campList = Array.isArray(rawCampaigns) ? rawCampaigns : Object.values(rawCampaigns);

        for (const camp of campList) {
            if (!camp) continue;

            const isCampMatch = campaignId && String(camp.id || camp.campaign_id) === campaignId;
            const drops = camp.drops || camp.time_based_drops || [];

            for (const dr of drops) {
                const isDropMatch = dropId && String(dr.id || dr.drop_id) === dropId;

                if (isDropMatch || isCampMatch) {
                    const foundUrl = dr.benefits?.[0]?.image_url 
                        || dr.image_url 
                        || dr.drop_icon 
                        || camp.image_url 
                        || camp.game_box_art_url 
                        || parentCampIcon 
                        || parentGameIcon 
                        || null;

                    if (foundUrl) return foundUrl;
                }
            }
        }

        return parentCampIcon || parentGameIcon || null;
    };

    // 2. Extrakce seznamu her / kampaní
    const rawList = rawData.wanted_items || rawCampaigns || rawData.games || [];
    const list = Array.isArray(rawList) ? rawList : Object.values(rawList);

    // 3. Transformace na View Model
    const wantedTree = list.map((g, gIndex) => {
        const gameName = g.game_name || g.name || 'Unknown Game';
        const gameSlug = slugify(gameName);
        const gameId = String(g.game_id || g.id || `game_${gameSlug}_${gIndex + 1}`);
        const gameIcon = g.game_icon || g.box_art_url || g.game_box_art_url || null;

        const gCampaigns = g.campaigns || (g.drops ? [g] : []);

        const mappedCampaigns = gCampaigns.map((c, cIndex) => {
            const campaignName = c.name || c.campaign_name || 'Campaign';
            const campaignSlug = slugify(campaignName);
            const campaignId = String(c.id || c.campaign_id || `${gameSlug}_camp_${cIndex + 1}`);
            const campaignIcon = c.image_url || c.campaign_icon || c.game_box_art_url || gameIcon;

            const rawDrops = c.drops || c.time_based_drops || [];

            // A) Předpočítání dropů
            const mappedDrops = rawDrops.map((d, dIndex) => {
                const dropName = d.name || d.drop_name || `Drop ${dIndex + 1}`;
                const dropSlug = slugify(dropName);
                const safeDropId = String(d.id || d.drop_id || `${campaignId}_drop_${dropSlug}_${dIndex + 1}`);

                const currentMins = Number(d.current_minutes || 0);
                const requiredMins = Number(d.required_minutes || 0);
                const remainingMins = Math.max(0, requiredMins - currentMins);
                const isClaimed = Boolean(d.is_claimed || d.claimed);

                let progressPct = 0;
                if (requiredMins > 0) {
                    progressPct = Math.min(100, Math.max(0, Math.round((currentMins / requiredMins) * 100)));
                } else if (typeof d.progress === 'number') {
                    progressPct = d.progress <= 1 ? Math.round(d.progress * 100) : Math.round(d.progress);
                }

                const canClaim = Boolean(d.can_claim ?? (!isClaimed && requiredMins > 0 && currentMins >= requiredMins));

                // 🎯 Původní vyvolání resolve logiky
                const resolvedImageUrl = resolveDropImageUrl(d, campaignId, campaignIcon, gameIcon);

                return {
                    ...d,
                    id: safeDropId,
                    drop_id: safeDropId,
                    campaign_id: campaignId,
                    name: dropName,
                    current_minutes: currentMins,
                    required_minutes: requiredMins,
                    remaining_minutes: remainingMins,
                    progress: progressPct,
                    is_claimed: isClaimed,
                    can_claim: canClaim,
                    image_url: resolvedImageUrl
                };
            });

            // B) Těžba a statistiky kampaně
            let isActivelyMining = false;
            if (currentDrop) {
                const curCampId = String(currentDrop.campaign_id || '').trim();
                const curDropId = String(currentDrop.drop_id || currentDrop.id || '').trim();

                if (curCampId && curCampId === campaignId) {
                    isActivelyMining = true;
                } else if (curDropId && mappedDrops.some(dropItem => dropItem.id === curDropId)) {
                    isActivelyMining = true;
                }
            }

            if (!isActivelyMining && watchedChannelObj?.campaign_id && watchedChannelObj.campaign_id === campaignId) {
                isActivelyMining = true;
            }

            const totalDrops = mappedDrops.length;
            const claimedDrops = mappedDrops.filter(dropItem => dropItem.is_claimed).length;
            const inProgressDrops = mappedDrops.filter(dropItem => !dropItem.is_claimed && dropItem.current_minutes > 0).length;

            const totalReq = mappedDrops.reduce((sum, dropItem) => sum + dropItem.required_minutes, 0);
            const totalCur = mappedDrops.reduce((sum, dropItem) => sum + dropItem.current_minutes, 0);
            const totalRemainingMins = mappedDrops.reduce((sum, dropItem) => sum + dropItem.remaining_minutes, 0);

            const overallPct = totalReq > 0 ? Math.min(100, Math.max(0, Math.round((totalCur / totalReq) * 100))) : 0;
            const isReady = mappedDrops.some(dropItem => dropItem.can_claim);
            const isClaimed = totalDrops > 0 && claimedDrops === totalDrops;
            const hasProgress = !isActivelyMining && inProgressDrops > 0;

            let classList = ['wanted-card'];
            if (isActivelyMining) classList.push('is-mining', 'active-mining');
            else if (isReady) classList.push('is-ready', 'ready');
            else if (isClaimed) classList.push('is-claimed', 'completed');
            else if (hasProgress) classList.push('in-progress');

            return {
                ...c,
                id: campaignId,
                campaign_id: campaignId,
                campaign_slug: campaignSlug,
                name: campaignName,
                game_name: gameName,
                game_icon: gameIcon,
                campaign_icon: campaignIcon,
                overall_progress: overallPct,
                total_remaining_minutes: totalRemainingMins,
                claimed_drops_count: claimedDrops,
                total_drops_count: totalDrops,
                is_mining: isActivelyMining,
                has_progress: hasProgress,
                is_ready: isReady,
                is_claimed: isClaimed,
                card_classes: classList.join(' '),
                drops: mappedDrops
            };
        });

        return {
            ...g,
            id: gameId,
            game_id: gameId,
            game_slug: gameSlug,
            game_name: gameName,
            game_icon: gameIcon,
            campaigns: mappedCampaigns
        };
    }).filter(Boolean);

    // 4. Extrakce inventáře
    const rawInv = rawData.inventory || rawData.user_inventory || [];
    const inventoryData = Array.isArray(rawInv) ? rawInv : Object.values(rawInv);

    // 5. Zápis do globálního stavu
    window.state = {
        ...window.state,
        status,
        current_drop: currentDrop,
        watching_channel: watchingChannel,
        channels,
        settings,
        manual_mode: manualMode,
        active_game: activeGame,
        campaigns: rawCampaigns,
        wanted_items: wantedTree,
        inventory: inventoryData
    };

//    console.log(`[${new Date().toLocaleTimeString()}] ⚙️ [State] Globální state aktualizován:`, window.state);

    window.dispatchEvent(new CustomEvent('stateUpdated'));
    debugger;
}

// 2. Minutová smyčka pro pravidelnou obnovu stavu
setInterval(() => {
    if (socket && socket.connected) {
 //       console.log(`[${new Date().toLocaleTimeString()}] 📤 [INSPEKTOR] Posílám žádost o nový state...`);
        socket.emit('state');
    } else {
        console.warn('⚠️ Soket není připojen, přesakuji minutový emit.');
    }
// }, 60 * 1000);
}, 1000);


////////////////////////////////////////////////////
//////////////////////////////////////////////////// PARSERY
////////////////////////////////////////////////////


// 1. Parser pro Hru
function getGame(g = {}) {
    const safeMins = Math.max(0, Number(g.total_remaining_minutes) || 0);
    const hours = Math.floor(safeMins / 60);
    const remainderMins = safeMins % 60;

    return {
        name: g.game_name || 'Neznámá hra',
        iconUrl: g.game_icon || '',
        timeText: hours > 0 ? `${hours}h ${remainderMins}m` : `${remainderMins}m`,
        campaigns: g.campaigns || []
    };
}

// 2. Parser pro Kampaň
function getCampaign(c = {}) {
    const isMining = Boolean(c.is_mining || c.isMining);
    const hasProgress = Boolean(c.has_progress || c.hasProgress);
    const isReady = Boolean(c.is_ready || c.isReady);
    const isClaimed = Boolean(c.is_claimed || c.isClaimed);

    let tagClass = 'tag-queued';
    let tagLabel = 'V pořadí';
    let tagIcon = 'upcoming';

    if (isClaimed) {
        tagClass = 'tag-claimed';
        tagLabel = 'Dokončeno';
        tagIcon = 'completed';
    } else if (isReady) {
        tagClass = 'tag-ready';
        tagLabel = 'K vyzvednutí';
        tagIcon = 'ready';
    } else if (isMining) {
        tagClass = 'tag-mining';
        tagLabel = 'Těží se';
        tagIcon = 'active';
    } else if (hasProgress) {
        tagClass = 'tag-in-progress';
        tagLabel = 'Probíhá';
        tagIcon = 'in-progress';
    }

    const totalRemainingMinutes = Number(c.total_remaining_minutes || c.totalRemainingMinutes || c.remaining_minutes || c.remainingMinutes) || 0;

    // --- SOUČET MINUT Z DROPŮ PRO PROGRESS BAR ---
    const drops = c.drops || [];
    let requiredMinutes = 0;
    let currentMinutes = 0;

    drops.forEach((d) => {
        const req = Number(d.required_minutes || d.requiredMinutes || d.required) || 0;
        const cur = Number(d.current_minutes || d.currentMinutes || d.current) || 0;
        const claimed = Boolean(d.is_claimed || d.isClaimed);

        requiredMinutes += req;
        if (claimed) {
            currentMinutes += req;
        } else {
            currentMinutes += Math.min(cur, req);
        }
    });

    const progressPct = requiredMinutes > 0 
        ? Math.min(100, Math.round((currentMinutes / requiredMinutes) * 100)) 
        : 0;

    return {
        id: String(c.campaign_id || c.id || ''),
        slug: c.campaign_slug || c.slug || '',
        name: c.name || c.campaign_name || 'Bez názvu',
        url: c.url || '#',
        gameName: c.game_name || c.gameName || '',
        gameIcon: c.game_icon || c.gameIcon || '',
        
        // Minuty a naformátovaný text
        totalRemainingMinutes,
        totalRemainingText: c.total_remaining_text || c.totalRemainingText || (totalRemainingMinutes > 0 ? `${totalRemainingMinutes} min` : ''),
        
        // Agregovaný pokrok kampaně pro progress bar
        requiredMinutes,
        currentMinutes,
        progressPct,

        cardClasses: c.card_classes || c.cardClasses || 'wanted-card',
        claimedCount: Number(c.claimed_drops_count || c.claimedCount) || 0,
        totalCount: Number(c.total_drops_count || c.totalCount) || 0,
        
        // Stavy
        isMining,
        hasProgress,
        isReady,
        isClaimed,
        
        statusClass: isClaimed ? 'claimed' : (isReady ? 'ready' : (isMining ? 'mining' : (hasProgress ? 'in-progress' : 'queued'))),
        tagClass,
        tagLabel,
        tagIcon,
        
        startsAt: c.starts_at || c.startsAt,
        endsAt: c.ends_at || c.endsAt,
        drops
    };
}

// 3. Parser pro Drop
function getDrop(d = {}, dropIdx = 0, activeDrop = null) {
    const id = String(d.drop_id || d.id || '').trim();
    const name = d.name || '';
    const isClaimed = Boolean(d.is_claimed);
    const canClaim = Boolean(d.can_claim);
    const required = Number(d.required_minutes) || 0;

    const isCurrentlyActive = activeDrop && !isClaimed && String(activeDrop.drop_id || activeDrop.id || '').trim() === id;
    const rawMinutes = isCurrentlyActive ? activeDrop.current_minutes : d.current_minutes;
    const current = isClaimed ? required : Math.round(Number(rawMinutes) || 0);

    const pct = required > 0 ? Math.min(100, Math.max(0, Math.round((current / required) * 100))) : 0;

    return {
        id,
        name,
        displayName: `Drop ${dropIdx + 1}: ${name}`,
        isClaimed,
        canClaim,
        required,
        current,
        pct,
        imageUrl: d.image_url || '',
        benefits: d.benefits || []
    };
}

/**
 * Bezpečně vytáhne a naparsuje celou frontu chtěných her (Wanted Queue) ze stavu.
 * @param {Object} rawAppState - Globální stav (výchozí: window.state)
 * @returns {Array} Pole naparsovaných her
 */
function getWantedQueue(rawAppState = window.state) {
    if (!rawAppState || typeof rawAppState !== 'object') {
        return [];
    }

    // Odolnost vůči různým názvům klíčů v objektu
    const rawQueue = rawAppState.wanted_items 
                  || rawAppState.wantedItems 
                  || rawAppState.wantedTree 
                  || [];

    if (!Array.isArray(rawQueue)) {
        return [];
    }

    // Každou hru rovnou bezpečně naparsujeme a vyfiltrujeme případné neplatné hodnoty
    return rawQueue
        .map(rawGame => (typeof getGame === 'function' ? getGame(rawGame) : rawGame))
        .filter(Boolean);
}


