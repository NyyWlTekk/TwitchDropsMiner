////////////////////////////////////////////////////////////////////////////
// ==================== Active Drop & Campaign Rotation ====================
////////////////////////////////////////////////////////////////////////////

let lastDropHeaderHash = '';
let lastDropCardLayoutHash = '';
let cachedIconContainer = '';
let cachedInfoTextDiv = '';

/**
 * Aktualizuje celkový progress bar a text v UI.
 */
// entry point
function updateOverallProgress() {
    const overallFill = document.getElementById('overall-progress-fill');
    const overallText = document.getElementById('overall-progress-text');
    const overallTimeEl = document.getElementById('overall-progress-time');

    if (!overallFill || !overallText) return;

    const stats = calculateOverallStats();
    
    if (stats.totalRequired > 0) {
        const percentage = Math.min(100, Math.round((stats.totalCurrent / stats.totalRequired) * 100));
        overallFill.style.width = `${percentage}%`;
        overallFill.textContent = percentage > 5 ? `${percentage}%` : '';
        overallText.textContent = `${percentage}% (${stats.totalCurrent} / ${stats.totalRequired} min)`;
    } else {
        overallFill.style.width = '0%';
        overallFill.textContent = '';
        overallText.textContent = '0% (0 / 0 min)';
    }

    if (overallTimeEl) {
        const secs = stats.totalRemainingSecs || 0;
        const totalMins = Math.floor(secs / 60);
        const hours = Math.floor(totalMins / 60);
        const mins = totalMins % 60;
        
        let timeFormatted = '0m';
        if (hours > 0 && mins > 0) {
            timeFormatted = `${hours}h ${mins}m`;
        } else if (hours > 0) {
            timeFormatted = `${hours}h`;
        } else if (mins > 0) {
            timeFormatted = `${mins}m`;
        }

        overallTimeEl.textContent = `Zbývá celkem: ${timeFormatted}`;
    }
}

/**
 * Spočíta celkové statistiky ze sjednoceného stromu wantedItemsTree.
 */
function calculateOverallStats() {
    const tree = state?.wantedItemsTree || [];
    if (!Array.isArray(tree)) return { totalRequired: 0, totalCurrent: 0, totalRemainingSecs: 0 };

    let totalCurrentMins = 0;
    let totalRequiredMins = 0;
    let totalRemainingMins = 0;

    for (const game of tree) {
        if (!game) continue;
        totalRemainingMins += Number(game.total_remaining_minutes || 0);

        for (const campaign of (game.campaigns || [])) {
            for (const drop of (campaign.drops || [])) {
                if (!drop || drop.is_claimed) continue;

                totalCurrentMins += Number(drop.current_minutes || 0);
                totalRequiredMins += Number(drop.required_minutes || 0);
            }
        }
    }

    return {
        totalCurrent: totalCurrentMins,
        totalRequired: totalRequiredMins,
        totalRemainingSecs: totalRemainingMins * 60
    };
}

/**
 * Hlavní renderovací funkce hlavičky hry/kampaně.
 */
function renderDropGameHeader(data, force = false) {
    const dropGameEl = document.getElementById('drop-game');
    if (!dropGameEl) return;

    const enrichedData = getHeaderDataFromWantedTree(data);
    if (!enrichedData) return;

    const titleText = enrichedData.game_name || enrichedData.name || '';
    const subTextContent = enrichedData.campaign_name || '';
    const campaignUrl = enrichedData.campaign_url || enrichedData.url || '#';
    const iconUrl = enrichedData.game_icon || null;
    const effectiveCampaignId = enrichedData.campaign_id || '';

    ensureHeaderContainers(dropGameEl);

    const currentHash = `${effectiveCampaignId}_${titleText}_${subTextContent}_${campaignUrl}_${iconUrl}`;
    if (!force && lastDropHeaderHash === currentHash) {
        return;
    }
    lastDropHeaderHash = currentHash;

    if (typeof updateHeaderIcon === 'function') updateHeaderIcon(iconUrl);
    if (typeof updateHeaderTitle === 'function') updateHeaderTitle(titleText);
    
    updateHeaderSubtitle(subTextContent, campaignUrl);
}

/**
 * Ensures and returns the right column element inside the card outer container
 */
function ensureDropCardRightCol(cardOuter) {
    if (!cardOuter) return null;

    let rightCol = cardOuter.querySelector('#drop-card-right-col');
    if (!rightCol) {
        rightCol = document.createElement('div');
        rightCol.id = 'drop-card-right-col';
        Object.assign(rightCol.style, {
            flex: '1',
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'space-between',
            gap: '6px',
            minWidth: '0'
        });

        rightCol.append(...cardOuter.childNodes);

        Object.assign(cardOuter.style, {
            display: 'flex',
            flexDirection: 'row',
            alignItems: 'stretch',
            gap: '12px'
        });
        cardOuter.appendChild(rightCol);
    }
    return rightCol;
}

/**
 * Resets the drop game header content
 */
function resetDropHeader(dropGameEl) {
    if (!dropGameEl) return;
    if (lastDropHeaderHash !== 'empty') {
        const titleEl = dropGameEl.querySelector('#drop-header-title');
        const subEl = dropGameEl.querySelector('#drop-header-subtitle');
        const iconEl = dropGameEl.querySelector('#drop-header-icon');
        if (titleEl) titleEl.textContent = '';
        if (subEl) subEl.textContent = '';
        if (iconEl) iconEl.innerHTML = '';
        lastDropHeaderHash = 'empty';
    }
}

/**
 * Updates header icon image safely with proper aspect ratio and scaling
 */
function updateHeaderIcon(iconUrl) {
    const iconEl = document.getElementById('drop-header-icon');
    if (!iconEl) return;

    if (!iconUrl) {
        iconEl.innerHTML = '';
        return;
    }

    let img = iconEl.querySelector('img');
    if (!img) {
        img = document.createElement('img');
        img.className = 'drop-header-img';
        Object.assign(img.style, {
            width: '100%',
            height: '100%',
            objectFit: 'cover',
            display: 'block'
        });
        iconEl.innerHTML = '';
        iconEl.appendChild(img);
    }

    if (img.src !== iconUrl) {
        img.src = iconUrl;
    }
}

/**
 * Zajišťuje strukturu kontejneru hlavičky
 */
function ensureHeaderContainers(dropGameEl) {
    if (!dropGameEl) return;

    Object.assign(dropGameEl.style, {
        display: 'flex',
        alignItems: 'center',
        gap: '14px',
        margin: '10px 0'
    });

    if (!cachedIconContainer) {
        cachedIconContainer = document.createElement('div');
        cachedIconContainer.id = 'drop-header-icon';
        cachedIconContainer.className = 'game-icon-container';
        Object.assign(cachedIconContainer.style, {
            width: '54px',
            height: '72px',
            minWidth: '54px',
            minHeight: '72px',
            flexShrink: '0',
            borderRadius: '8px',
            overflow: 'hidden',
            backgroundColor: 'rgba(255, 255, 255, 0.05)',
            border: '1px solid rgba(255, 255, 255, 0.12)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            boxShadow: '0 4px 12px rgba(0, 0, 0, 0.25)'
        });
    }

    if (!cachedInfoTextDiv) {
        cachedInfoTextDiv = document.createElement('div');
        cachedInfoTextDiv.className = 'drop-game-text-info';
        Object.assign(cachedInfoTextDiv.style, {
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'center',
            gap: '3px'
        });

        cachedInfoTextDiv.innerHTML = `
            <div id="drop-header-title" class="drop-header-title" style="font-weight: 700; font-size: 1.15em; color: #fff; letter-spacing: 0.2px;"></div>
            <a id="drop-header-subtitle" class="drop-header-subtitle" target="_blank" rel="noopener noreferrer" style="font-size: 0.9em; font-weight: 500; color: #a970ff; text-decoration: none; transition: color 0.2s, text-decoration 0.2s;"></a>
        `;

        const linkEl = cachedInfoTextDiv.querySelector('#drop-header-subtitle');
        if (linkEl) {
            linkEl.addEventListener('mouseenter', () => {
                linkEl.style.color = '#bf94ff';
                linkEl.style.textDecoration = 'underline';
            });
            linkEl.addEventListener('mouseleave', () => {
                linkEl.style.color = '#a970ff';
                linkEl.style.textDecoration = 'none';
            });
        }
    }

    if (!dropGameEl.contains(cachedIconContainer) || !dropGameEl.contains(cachedInfoTextDiv)) {
        dropGameEl.replaceChildren(cachedIconContainer, cachedInfoTextDiv);
    }
}

/**
 * Vytáhne kompletní data ze stromu wantedItemsTree podle ID nebo Násobení podle názvu
 */
function getHeaderDataFromWantedTree(rawDropData) {
    if (!rawDropData) return null;

    const currentTree = typeof state !== 'undefined' ? state.wantedItemsTree : null;
    if (!Array.isArray(currentTree) || currentTree.length === 0) {
        return rawDropData;
    }

    const dropId = String(rawDropData.id || rawDropData.drop_id || rawDropData.dropId || '').trim();
    const dropNameTarget = String(rawDropData.name || rawDropData.drop_name || rawDropData.title || '').trim().toLowerCase();
    const campId = String(rawDropData.campaign_id || '').trim();
    const gameNameTarget = String(rawDropData.game_name || rawDropData.game || rawDropData.game_title || '').trim().toLowerCase();

    const safeLower = (val) => String(val || '').trim().toLowerCase();

    let matchedGame = null;
    let matchedCampaign = null;
    let matchedDrop = null;

    for (const game of currentTree) {
        if (!game || !Array.isArray(game.campaigns)) continue;

        const isGameMatch = gameNameTarget && safeLower(game.game_name) === gameNameTarget;

        for (const campaign of game.campaigns) {
            if (!campaign || !Array.isArray(campaign.drops)) continue;

            const isCampMatch = campId && String(campaign.id || campaign.campaign_id) === campId;

            for (const drop of campaign.drops) {
                if (!drop) continue;

                const isDropIdMatch = dropId && String(drop.id || drop.drop_id) === dropId;
                const isDropNameMatch = dropNameTarget && safeLower(drop.name || drop.title) === dropNameTarget;

                if (isDropIdMatch || (isGameMatch && isDropNameMatch) || isDropNameMatch) {
                    matchedGame = game;
                    matchedCampaign = campaign;
                    matchedDrop = drop;
                    break;
                }
            }
            if (matchedDrop) break;
            
            if (isCampMatch && !matchedCampaign) {
                matchedGame = game;
                matchedCampaign = campaign;
            }
        }
        if (matchedDrop) break;
    }

    if (matchedDrop) {
        return {
            game_name: matchedGame?.game_name || rawDropData.game_name,
            game_icon: matchedGame?.game_icon || rawDropData.game_icon,
            campaign_name: matchedCampaign?.name || rawDropData.campaign_name,
            campaign_url: matchedCampaign?.url || rawDropData.url || '#',
            image_url: matchedDrop.image_url || matchedCampaign?.campaign_icon || rawDropData.image_url,
            campaign_id: matchedCampaign?.id || campId,
            drop_id: matchedDrop.id || dropId
        };
    }

    if (matchedCampaign) {
        const fallbackDrop = matchedCampaign.drops.find(d => !d.is_claimed) || matchedCampaign.drops[0];
        return {
            game_name: matchedGame?.game_name || rawDropData.game_name,
            game_icon: matchedGame?.game_icon || rawDropData.game_icon,
            campaign_name: matchedCampaign.name || rawDropData.campaign_name,
            campaign_url: matchedCampaign.url || rawDropData.url || '#',
            image_url: fallbackDrop?.image_url || matchedCampaign.campaign_icon || rawDropData.image_url,
            campaign_id: matchedCampaign.id || campId
        };
    }

    return rawDropData;
}

/**
 * Updates header title text
 */
function updateHeaderTitle(titleText) {
    const titleEl = document.getElementById('drop-header-title');
    if (titleEl && titleEl.textContent !== titleText) {
        titleEl.textContent = titleText;
    }
}

/**
 * Aktualizuje podnadpis kampaně (text i odkaz)
 */
function updateHeaderSubtitle(text, url) {
    const subEl = document.getElementById('drop-header-subtitle');
    if (!subEl) return;

    subEl.textContent = text || '';
    if (url && url !== '#') {
        subEl.href = url;
        subEl.style.pointerEvents = 'auto';
    } else {
        subEl.removeAttribute('href');
        subEl.style.pointerEvents = 'none';
    }
}

/**
 * Helper function to create a fallback reward placeholder element.
 */
function createRewardPlaceholder(elementId = null) {
    const placeholder = document.createElement('div');
    if (elementId) placeholder.id = elementId;
    
    placeholder.className = 'reward-placeholder drop-card-left-img image-placeholder drop-reward-placeholder';
    
    Object.assign(placeholder.style, {
        width: '72px',
        height: '72px',
        borderRadius: '6px',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        backgroundColor: 'rgba(255, 255, 255, 0.05)',
        border: '1px dashed rgba(255, 255, 255, 0.2)',
        fontSize: '24px',
        flexShrink: '0'
    });
    
    placeholder.textContent = '🎁';
    return placeholder;
}

/**
 * Executes a single tick of rotation process with comprehensive debugging.
 */
function executeRotationStep() {
    console.log("[Rotation] Debug - executeRotationStep() triggered.");
    
    const tree = state?.wantedItemsTree || state?.gameswantedtree || [];
    if (!Array.isArray(tree) || tree.length === 0) {
        console.warn("[Rotation] Debug - tree is empty or invalid:", tree);
        const noDropMessage = document.getElementById('no-drop-message');
        const dropInfo = document.getElementById('drop-info');
        if (noDropMessage) noDropMessage.style.display = 'block';
        if (dropInfo) dropInfo.style.display = 'none';
        return;
    }

    const validDrops = [];
    for (const game of tree) {
        if (!game) continue;
        const gameName = game.game_name || game.name || '';

        for (const campaign of (game.campaigns || [])) {
            if (!campaign || campaign.is_claimed) continue;
            const campaignId = campaign.campaign_id || campaign.id || '';
            const campaignName = campaign.name || campaign.campaign_name || '';
            
            // Extract campaign icon/image safely
            const campaignImage = campaign.image_url || campaign.icon || campaign.campaign_icon || campaign.thumbnail_url || '';

            for (const drop of (campaign.drops || [])) {
                if (!drop || drop.is_claimed) continue;

                const req = Number(drop.required_minutes || drop.total_minutes || 0);
                const cur = Number(drop.current_minutes || 0);
                
                if (req > 0 && cur >= req) continue;

                validDrops.push({
                    ...drop,
                    required_minutes: req > 0 ? req : drop.required_minutes,
                    current_minutes: cur,
                    campaign_id: campaignId,
                    campaign_name: campaignName,
                    campaign_image: campaignImage,
                    game_name: gameName,
                    image_url: drop.image_url || campaignImage,
                    drop_id: drop.drop_id || drop.id || '',
                    drop_name: drop.name || drop.drop_name || drop.title || 'Drop'
                });
            }
        }
    }

    console.log("[Rotation] Debug - collected validDrops list:", validDrops);

    const noDropMessage = document.getElementById('no-drop-message');
    const dropInfo = document.getElementById('drop-info');

    if (validDrops.length === 0) {
        console.warn("[Rotation] Debug - no valid drops found after filtering.");
        if (noDropMessage) noDropMessage.style.display = 'block';
        if (dropInfo) dropInfo.style.display = 'none';
        return;
    }

    if (!state || typeof state !== 'object') return;

    if (state.dropRotationIndex == null || state.dropRotationIndex >= validDrops.length || state.dropRotationIndex < 0) {
        state.dropRotationIndex = 0;
    }

    const currentDrop = validDrops[state.dropRotationIndex];
    console.log("[Rotation] Debug - current selected drop at index", state.dropRotationIndex, ":", currentDrop);

    const currentId = String(currentDrop.drop_id || currentDrop.id || '');

    const existingDrop = state?.currentDrop;
    const existingId = String(existingDrop?.drop_id || existingDrop?.id || '');
    const hasChanged = !existingId || existingId !== currentId;

    state.currentDrop = currentDrop;
    state.current_drop = currentDrop;

    if (noDropMessage) noDropMessage.style.display = 'none';
    if (dropInfo) dropInfo.style.display = 'block';

    const rewardImgUrl = currentDrop.image_url || currentDrop.campaign_image || '';

    if (typeof renderDropGameHeader === 'function') {
        renderDropGameHeader(currentDrop);
    }
    if (typeof renderDropCardLayout === 'function') {
        renderDropCardLayout(currentDrop, rewardImgUrl, hasChanged);
    }
    if (typeof renderAllProgressBars === 'function') {
        renderAllProgressBars(currentDrop.current_minutes || 0, currentDrop);
    } else if (typeof updateSingleDropDisplay === 'function') {
        updateSingleDropDisplay(currentDrop, hasChanged);
    }

    state.dropRotationIndex++;
    if (state.dropRotationIndex >= validDrops.length) {
        state.dropRotationIndex = 0;
    }
}

/**
 * Unified render function with execution logging.
 */
function renderDropCardLayout(data, rewardImgUrl, force = false) {
    console.log("[DropCard] Rendering layout for drop:", data, "with provided rewardImgUrl:", rewardImgUrl);
    
    const currentDropLabel = document.getElementById('current-drop-label');
    if (!currentDropLabel) {
        console.warn("[DropCard] Element #current-drop-label not found in DOM.");
        return;
    }

    if (!data || typeof data !== 'object') {
        console.warn("[DropCard] Invalid data passed to renderDropCardLayout.");
        currentDropLabel.textContent = '';
        return;
    }

    // Získání názvu dropu – záloha na benefits[0].name
    const dropName = data.drop_name || data.name || data.benefits?.[0]?.name || 'Drop';
    
    // Extrakce finální URL obrázku se zohledněním benefits v celém řetězci
    let resolvedViaFunc = null;
    if (typeof resolveDropImageUrl === 'function') {
        resolvedViaFunc = resolveDropImageUrl(data);
    } else if (typeof resolveDropRewardImageUrl === 'function') {
        resolvedViaFunc = resolveDropRewardImageUrl(data);
    }

    const finalImgUrl = resolvedViaFunc || 
                        (typeof rewardImgUrl === 'string' && rewardImgUrl.trim() !== '' ? rewardImgUrl.trim() : null) ||
                        data.benefits?.[0]?.image_url ||
                        data.image_url ||
                        data.drop_icon ||
                        null;

    console.log("[DropCard] Final resolved image URL to render:", finalImgUrl);

    const currentHash = `${data.drop_id || data.id || ''}_${dropName}_${finalImgUrl || ''}`;
    
    if (!force && typeof lastDropCardLayoutHash !== 'undefined' && lastDropCardLayoutHash === currentHash) {
        console.log("[DropCard] Layout hash matches, skipping re-render.");
        return; 
    }

    currentDropLabel.textContent = `⚡ Drop: ${dropName}`;

    const container = currentDropLabel.parentElement;
    if (!container) {
        console.warn("[DropCard] Parent container of currentDropLabel not found.");
        return;
    }

    const oldImages = container.querySelectorAll('.drop-card-left-img, .reward-placeholder');
    oldImages.forEach(img => img.remove());

    const createPlaceholder = () => {
        console.log("[DropCard] Creating reward placeholder (🎁)");
        const placeholder = document.createElement('div');
        placeholder.className = 'reward-placeholder drop-card-left-img image-placeholder';
        placeholder.textContent = '🎁';
        Object.assign(placeholder.style, {
            width: '40px',
            height: '40px',
            borderRadius: '4px',
            display: 'inline-flex',
            alignItems: 'center',
            justifyContent: 'center',
            backgroundColor: 'rgba(255, 255, 255, 0.05)',
            border: '1px dashed rgba(255, 255, 255, 0.2)',
            fontSize: '18px',
            flexShrink: '0',
            verticalAlign: 'middle',
            marginRight: '12px'
        });
        return placeholder;
    };

    let leftContent;
    if (finalImgUrl) {
        leftContent = document.createElement('img');
        leftContent.className = 'benefit-icon drop-reward-icon drop-card-left-img';
        leftContent.alt = dropName;
        leftContent.src = finalImgUrl;
        
        Object.assign(leftContent.style, {
            width: '40px', 
            height: '40px', 
            objectFit: 'contain', 
            borderRadius: '4px', 
            flexShrink: '0', 
            display: 'inline-block',
            verticalAlign: 'middle',
            marginRight: '12px'
        });
        
        leftContent.onerror = function() {
            console.error("[DropImage] Network or HTTP error loading image source:", finalImgUrl);
            this.replaceWith(createPlaceholder());
        };
    } else {
        leftContent = createPlaceholder();
    }

    if (leftContent) {
        container.insertBefore(leftContent, container.firstChild);
    }

    if (typeof lastDropCardLayoutHash !== 'undefined') {
        lastDropCardLayoutHash = currentHash;
    }
}

/**
 * Updates UI progress bars and text according to active drop progress
 */
function renderAllProgressBars(currentMins, dropData) {
    if (!dropData || typeof dropData !== 'object') return;

    const current = Number(currentMins) || 0;
    const reqMins = Number(dropData.required_minutes || 1);

    const dropPercentage = Math.min(100, Math.max(0, (current / reqMins) * 100));

    const fill = document.getElementById('progress-fill');
    if (fill) {
        fill.style.width = `${dropPercentage.toFixed(1)}%`;
        fill.textContent = `${Math.round(dropPercentage)}%`;
    }

    const progressText = document.getElementById('progress-text');
    if (progressText) {
        progressText.textContent = `${current} / ${reqMins} min`;
    }

    if (typeof updateCampaignProgressData === 'function') {
        updateCampaignProgressData(dropData, current);
    }
    if (typeof updateOverallProgress === 'function') {
        updateOverallProgress();
    }
}

/**
 * Unified and non-destructive version of drop card layout rendering.
 * Safely prepends the reward image or placeholder without breaking existing CSS structure.
 */
function renderDropCardLayout(data, rewardImgUrl, force = false) {
    const currentDropLabel = document.getElementById('current-drop-label');
    if (!currentDropLabel) return;

    if (!data || typeof data !== 'object') {
        currentDropLabel.textContent = '';
        return;
    }

    const dropName = data.drop_name || data.name || 'Drop';
    
    // Resolve final reward image URL safely using pure data logic
    const finalImgUrl = resolveDropImageUrl(data) || 
                        (typeof rewardImgUrl === 'string' && rewardImgUrl.trim() !== '' ? rewardImgUrl.trim() : null);

    const currentHash = `${data.drop_id || data.id || ''}_${dropName}_${finalImgUrl || ''}`;
    
    if (!force && typeof lastDropCardLayoutHash !== 'undefined' && lastDropCardLayoutHash === currentHash) {
        return; 
    }

    currentDropLabel.textContent = `⚡ Drop: ${dropName}`;

    // Find the immediate parent container holding the drop info
    const container = currentDropLabel.parentElement;
    if (!container) return;

    // Remove any previously rendered reward images or placeholders to prevent duplicates
    const oldImages = container.querySelectorAll('.drop-card-left-img, .reward-placeholder');
    oldImages.forEach(img => img.remove());

    // Construct and inject the new image or placeholder
    let leftContent;
    if (finalImgUrl) {
        leftContent = document.createElement('img');
        leftContent.className = 'benefit-icon drop-reward-icon drop-card-left-img';
        leftContent.alt = dropName;
        leftContent.src = finalImgUrl;
        
        Object.assign(leftContent.style, {
            width: '72px', 
            height: '72px', 
            objectFit: 'contain', 
            borderRadius: '6px', 
            flexShrink: '0', 
            display: 'inline-block',
            verticalAlign: 'middle',
            marginRight: '12px'
        });
        
        leftContent.onerror = function() {
            console.warn("[DropImage] Image failed to load, falling back to placeholder.", finalImgUrl);
            if (typeof createRewardPlaceholder === 'function') {
                this.replaceWith(createRewardPlaceholder());
            }
        };
    } else if (typeof createRewardPlaceholder === 'function') {
        leftContent = createRewardPlaceholder();
        Object.assign(leftContent.style, {
            display: 'inline-flex',
            verticalAlign: 'middle',
            marginRight: '12px'
        });
    }

    if (leftContent) {
        // Insert the image or placeholder safely at the very beginning of the container
        container.insertBefore(leftContent, container.firstChild);
    }

    if (typeof lastDropCardLayoutHash !== 'undefined') {
        lastDropCardLayoutHash = currentHash;
    }
}

/**
 * Updates the single active drop display with caching, queue matching, and DOM rendering.
 */
function updateSingleDropDisplay(data, isFromRotation = false) {
    if (!data || typeof data !== 'object') return;

    const targetId = data.drop_id || data.id;
    if (!targetId) return;

    const activeDrop = typeof getSafeActiveDrop === 'function' ? getSafeActiveDrop() : null;
    const activeId = activeDrop ? (activeDrop.drop_id || activeDrop.id) : null;
    const isCurrentDrop = activeId != null && String(activeId) === String(targetId);

    if (!isFromRotation && activeId != null && !isCurrentDrop) {
        return;
    }

    const dropsQueue = Array.isArray(state?.activeDropsQueue) ? state.activeDropsQueue : [];

    if (activeDrop && isCurrentDrop) {
        data = { ...activeDrop, ...data };
    } else if (dropsQueue.length > 0) {
        const queueItem = dropsQueue.find(d => (d?.drop_id || d?.id) === targetId);
        if (queueItem) {
            data = { ...queueItem, ...data };
        }
    }

    const freshQueueItem = dropsQueue.find(d => (d?.drop_id || d?.id) === targetId);
    if (freshQueueItem?.current_minutes !== undefined) {
        data.current_minutes = freshQueueItem.current_minutes;
    }

    if (activeDrop?.current_minutes !== undefined && !data.is_claimed) {
        const isSameContext = (data.campaign_id && activeDrop.campaign_id && String(data.campaign_id) === String(activeDrop.campaign_id)) ||
                              (data.game_name && activeDrop.game_name && data.game_name === activeDrop.game_name);

        if (isSameContext) {
            const liveMins = Math.max(Number(data.current_minutes || 0), Number(activeDrop.current_minutes));
            data.current_minutes = liveMins;
        }
    }

    const reqMins = Number(data.required_minutes || data.total_minutes || 0);
    const curMins = Number(data.current_minutes || 0);

    const isDropClaimed = typeof isClaimed === 'function' ? isClaimed(data) : Boolean(data.is_claimed);

    if (isDropClaimed || (reqMins > 0 && curMins >= reqMins)) {
        if (Array.isArray(state?.activeDropsQueue)) {
            state.activeDropsQueue = state.activeDropsQueue.filter(d => (d?.drop_id || d?.id) !== targetId);
        }
        if (typeof startCombinedRotation === 'function') {
            startCombinedRotation(true);
        }
        return;
    }

    let remSecs;
    if (data.remaining_seconds != null && !isFromRotation) {
        remSecs = Number(data.remaining_seconds);
    } else if (isCurrentDrop && activeDrop?.remaining_seconds != null && !isFromRotation) {
        remSecs = Number(activeDrop.remaining_seconds);
    } else {
        remSecs = Math.max(0, (reqMins - curMins) * 60);
    }

    data.remaining_seconds = remSecs;

    if (typeof debugTime === 'function') {
        debugTime('2. DISPLAY_UPDATE', data);
    }

    if (state && typeof state === 'object') {
        state.currentDrop = data;
        state.current_drop = data;
    }

    const noDropMessage = document.getElementById('no-drop-message');
    const dropInfo = document.getElementById('drop-info');
    if (noDropMessage) noDropMessage.style.display = 'none';
    if (dropInfo) dropInfo.style.display = 'block';

    // Extrakce obrázku odměny s prioritním resolveDropRewardImageUrl vč. benefits
    const rewardImgUrl = typeof resolveDropRewardImageUrl === 'function' 
        ? resolveDropRewardImageUrl(data, targetId) 
        : (data.benefits?.[0]?.image_url || data.image_url || data.drop_icon || '');

    if (typeof updateDropTitle === 'function') updateDropTitle(data);
    if (typeof renderDropGameHeader === 'function') renderDropGameHeader(data);
    if (typeof renderDropCardLayout === 'function') renderDropCardLayout(data, rewardImgUrl);
    if (typeof renderAllProgressBars === 'function') renderAllProgressBars(curMins, data);
    if (typeof updateRemainingTime === 'function') updateRemainingTime(remSecs, data);
}

/**
 * Switches current campaign display, filters active drops queue, and triggers UI updates.
 */
function switchCampaignDisplay(data, isManualSwitch = false, shouldUpdateDisplay = true) {
    if (data && typeof data === 'object') {
        const now = Date.now();

        if (data.ends_at) {
            const endTime = new Date(data.ends_at).getTime();
            if (!isNaN(endTime) && endTime <= now) {
                if (typeof clearDropProgress === 'function') {
                    clearDropProgress();
                }
                return;
            }
        }

        const curMins = data.current_minutes;
        const reqMins = data.required_minutes;
        if (curMins !== undefined && reqMins !== undefined && reqMins > 0 && curMins >= reqMins) {
            if (typeof clearDropProgress === 'function') {
                clearDropProgress();
            }
            return;
        }
    }

    if (typeof cleanupClaimedCampaigns === 'function') {
        cleanupClaimedCampaigns();
    }

    if (!Array.isArray(state?.activeCampaignsQueue) || state.activeCampaignsQueue.length === 0) {
        if (Array.isArray(state?._lastValidActiveCampaignsQueue) && state._lastValidActiveCampaignsQueue.length > 0) {
            state.activeCampaignsQueue = state._lastValidActiveCampaignsQueue;
        }
    } else if (state && typeof state === 'object') {
        state._lastValidActiveCampaignsQueue = state.activeCampaignsQueue;
    }

    const activeDrop = typeof getSafeActiveDrop === 'function' ? getSafeActiveDrop() : null;
    const previousDropId = activeDrop ? (activeDrop.drop_id || activeDrop.id) : null;

    const { drops = [] } = typeof getCampaignAndDrops === 'function'
        ? getCampaignAndDrops(data)
        : { drops: [] };

    if (drops.length > 0) {
        const targetDropId = data?.drop_id;

        if (targetDropId) {
            const targetDrop = drops.find(d => (d?.id || d?.drop_id) === targetDropId);
            if (targetDrop) {
                if (data.current_minutes !== undefined) targetDrop.current_minutes = data.current_minutes;
                if (data.required_minutes !== undefined) targetDrop.required_minutes = data.required_minutes;
                if (data.remaining_seconds !== undefined) targetDrop.remaining_seconds = data.remaining_seconds;
                if (data.is_claimed !== undefined) targetDrop.is_claimed = data.is_claimed;
            }
        }

        const unclaimedDrops = drops.filter(d => (typeof isClaimed === 'function' ? !isClaimed(d) : !d.is_claimed));
        const targetDrops = unclaimedDrops.length > 0 ? unclaimedDrops : drops;

        if (state && typeof state === 'object') {
            state.activeDropsQueue = typeof mapDropsForQueue === 'function'
                ? mapDropsForQueue(targetDrops, data)
                : targetDrops;
        }

        if (isManualSwitch) {
            const activeQueue = state?.activeDropsQueue ?? [];
            const idx = activeQueue.findIndex(d => (d?.drop_id || d?.id) === targetDropId);
            if (idx !== -1 && state) {
                state.dropRotationIndex = idx;
            }

            setTimeout(() => {
                if (typeof startCombinedRotation === 'function') {
                    startCombinedRotation(true);
                }
            }, 0);
        }
    } else if (state && typeof state === 'object') {
        state.activeDropsQueue = data ? [data] : [];
    }

    if (typeof preloadQueueImages === 'function' && Array.isArray(state?.activeDropsQueue)) {
        preloadQueueImages(state.activeDropsQueue);
    }

    const rotationIdx = state?.dropRotationIndex ?? 0;
    const initialActiveDrop = state?.activeDropsQueue?.[rotationIdx]
        ?? state?.activeDropsQueue?.[0]
        ?? data;

    const newDropId = initialActiveDrop ? (initialActiveDrop.drop_id || initialActiveDrop.id) : null;
    const dropChanged = !previousDropId || !newDropId || String(previousDropId) !== String(newDropId);

    if (shouldUpdateDisplay && typeof updateSingleDropDisplay === 'function') {
        updateSingleDropDisplay(initialActiveDrop, dropChanged);
    }
}

/**
 * Updates UI and state with incoming drop progress data from tick/socket
 */
function updateDropProgress(dropData) {
    if (typeof debugTime === 'function') {
        debugTime('1. INCOMING_TICK', dropData);
    }

    if (!dropData || typeof dropData !== 'object' || Object.keys(dropData).length === 0) {
        if (typeof clearDropProgress === 'function') {
            clearDropProgress();
        }
        return;
    }

    const validDrop = dropData;
    const dropGame = validDrop.game_name || validDrop.game || '';

    if (!Array.isArray(state?.liveMiningQueue)) {
        if (state && typeof state === 'object') {
            state.liveMiningQueue = [];
        }
    }

    const activeCampId = validDrop.campaign_id;

    if (activeCampId && state?.campaigns?.[activeCampId]) {
        if (!state.liveMiningQueue.includes(activeCampId)) {
            state.liveMiningQueue.push(activeCampId);
        }
    }

    if (state?.campaigns) {
        state.liveMiningQueue = state.liveMiningQueue.filter(cid => {
            const camp = state.campaigns[cid];
            if (!camp || (typeof isClaimed === 'function' ? isClaimed(camp) : camp.is_claimed)) return false;

            const drops = typeof extractCampaignDrops === 'function' 
                ? extractCampaignDrops(camp) 
                : (camp.drops ?? []);

            return drops.some(d => (typeof isClaimed === 'function' ? !isClaimed(d) : !d.is_claimed));
        });

        state.activeCampaignsQueue = state.liveMiningQueue
            .map(cid => state.campaigns[cid])
            .filter(Boolean);
    }

    const incomingIdStr = String(validDrop.drop_id || validDrop.id || '');
    const currentMins = Math.round(Number(validDrop.current_minutes || 0));
    const reqMins = Number(validDrop.required_minutes || 0);

    const remSecs = validDrop.remaining_seconds != null
        ? Number(validDrop.remaining_seconds)
        : Math.max(0, (reqMins - currentMins) * 60);

    validDrop.current_minutes = currentMins;
    validDrop.remaining_seconds = remSecs;

    if (state && typeof state === 'object') {
        state.currentDrop = { ...validDrop };
        state.current_drop = { ...validDrop };
    }

    const noDropMessage = document.getElementById('no-drop-message');
    const dropInfo = document.getElementById('drop-info');
    if (noDropMessage) noDropMessage.style.display = 'none';
    if (dropInfo) dropInfo.style.display = 'block';

    const campaignTitleEl = document.getElementById('campaign-title') || document.querySelector('.campaign-header-title');
    if (campaignTitleEl && dropGame) {
        campaignTitleEl.textContent = dropGame;
    }

    const dropGameEl = document.getElementById('drop-game');
    if (dropGameEl) {
        dropGameEl.style.display = 'block';
    }
    if (typeof renderDropGameHeader === 'function') {
        renderDropGameHeader(validDrop);
    }

    const secondaryProgressBars = document.querySelectorAll('.secondary-progress-card, #fallback-drop-card');
    secondaryProgressBars.forEach(card => {
        card.style.display = 'none';
    });

    const timeRemainingEl = document.getElementById('progress-time');
    if (timeRemainingEl) {
        timeRemainingEl.style.display = 'block';
    }

    if (typeof syncAnyDropProgress === 'function') {
        syncAnyDropProgress(incomingIdStr, validDrop);
    } else if (typeof renderAllProgressBars === 'function') {
        renderAllProgressBars(currentMins, validDrop);
    }

    if (typeof updateSingleDropDisplay === 'function') {
        updateSingleDropDisplay(validDrop, false);
    }

    if (typeof updateCampaignProgressData === 'function') {
        updateCampaignProgressData(validDrop, currentMins);
    }
}

/**
 * Updates campaign progress bar and info based on current drop progress.
 */
function updateCampaignProgressData(data, liveCurrentMins) {
    const campaignFill = document.getElementById('campaign-progress-fill');
    const campaignText = document.getElementById('campaign-progress-text');
    const campaignTitle = document.getElementById('campaign-progress-title');

    if (!campaignFill || !campaignText || !data) return;

    const cardContainer = campaignFill.closest('.secondary-progress-card') ?? 
                          campaignFill.closest('.drop-card-container') ?? 
                          campaignFill.parentElement?.parentElement;

    const currentDropCurrent = liveCurrentMins ?? Number(data.current_minutes || 0);
    const targetDropId = String(data.drop_id || data.id || '');
    const campId = data.campaign_id;

    let totalCampaignCurrent = currentDropCurrent;
    let totalCampaignRequired = 0;

    if (state?.campaigns && campId) {
        let campaign = state.campaigns[campId];
        if (!campaign && typeof state.campaigns === 'object') {
            campaign = Object.values(state.campaigns).find(
                c => c && (c.id === campId || c.campaign_id === campId)
            );
        }

        if (campaign) {
            const drops = typeof extractCampaignDrops === 'function' 
                ? extractCampaignDrops(campaign) 
                : (campaign.drops ?? []);

            const campName = campaign.name || 'Campaign';
            const dropsCount = drops.length;

            let dropVisualIndex = 1;
            let maxCampaignRequired = 0;

            drops.forEach((d, i) => {
                if (!d) return;
                const dId = String(d.drop_id || d.id || '');

                if (dId === targetDropId) {
                    d.current_minutes = currentDropCurrent;
                    dropVisualIndex = i + 1;
                }

                const dReq = Number(d.required_minutes || 0);
                if (dReq > maxCampaignRequired) {
                    maxCampaignRequired = dReq;
                }
            });

            totalCampaignRequired = maxCampaignRequired > 0 
                ? maxCampaignRequired 
                : Number(campaign.total_minutes || campaign.required_minutes || 0);

            totalCampaignCurrent = currentDropCurrent;

            if (campaignTitle) {
                const newTitle = `${campName} • Drop ${dropVisualIndex}/${dropsCount}`;
                if (campaignTitle.textContent !== newTitle) {
                    campaignTitle.textContent = newTitle;
                }
            }
        }
    }

    if (totalCampaignRequired === 0) {
        totalCampaignRequired = Number(data.required_minutes || 0);
    }

    if (totalCampaignRequired > 0) {
        if (cardContainer && cardContainer.style.display !== 'block') {
            cardContainer.style.display = 'block';
        }

        const percentage = Math.min(100, Math.round((totalCampaignCurrent / totalCampaignRequired) * 100));
        const newWidth = `${percentage}%`;
        const newFillText = percentage > 0 ? `${percentage}%` : '';
        const newProgressText = `${totalCampaignCurrent} / ${totalCampaignRequired} min`;

        if (campaignFill.style.width !== newWidth) campaignFill.style.width = newWidth;
        if (campaignFill.textContent !== newFillText) campaignFill.textContent = newFillText;
        if (campaignText.textContent !== newProgressText) campaignText.textContent = newProgressText;
    } else if (cardContainer && cardContainer.style.display !== 'none') {
        cardContainer.style.display = 'none';
    }
}

/**
 * Executes a single tick of rotation process directly from wantedItemsTree
 */
function executeRotationStep() {
    const tree = state?.wantedItemsTree || state?.gameswantedtree || [];
    if (!Array.isArray(tree) || tree.length === 0) {
        const noDropMessage = document.getElementById('no-drop-message');
        const dropInfo = document.getElementById('drop-info');
        if (noDropMessage) noDropMessage.style.display = 'block';
        if (dropInfo) dropInfo.style.display = 'none';
        return;
    }

    const validDrops = [];
    for (const game of tree) {
        if (!game) continue;
        const gameName = game.game_name || game.name || '';

        // Fixed: Iterate over campaigns belonging to the game tree
        for (const campaign of (game.campaigns || [])) {
            if (!campaign || campaign.is_claimed) continue;
            const campaignId = campaign.campaign_id || campaign.id || '';
            const campaignName = campaign.name || campaign.campaign_name || '';

            for (const drop of (campaign.drops || [])) {
                if (!drop || drop.is_claimed) continue;

                const req = Number(drop.required_minutes || drop.total_minutes || 0);
                const cur = Number(drop.current_minutes || 0);
                
                if (req > 0 && cur >= req) continue;

                validDrops.push({
                    ...drop,
                    required_minutes: req > 0 ? req : drop.required_minutes,
                    current_minutes: cur,
                    campaign_id: campaignId,
                    campaign_name: campaignName,
                    game_name: gameName,
                    image_url: drop.image_url || '',
                    drop_id: drop.drop_id || drop.id || '',
                    drop_name: drop.name || drop.drop_name || drop.title || 'Drop'
                });
            }
        }
    }

    const noDropMessage = document.getElementById('no-drop-message');
    const dropInfo = document.getElementById('drop-info');

    if (validDrops.length === 0) {
        if (noDropMessage) noDropMessage.style.display = 'block';
        if (dropInfo) dropInfo.style.display = 'none';
        return;
    }

    if (!state || typeof state !== 'object') return;

    if (state.dropRotationIndex == null || state.dropRotationIndex >= validDrops.length || state.dropRotationIndex < 0) {
        state.dropRotationIndex = 0;
    }

    const currentDrop = validDrops[state.dropRotationIndex];
    const currentId = String(currentDrop.drop_id || currentDrop.id || '');

    const existingDrop = state?.currentDrop;
    const existingId = String(existingDrop?.drop_id || existingDrop?.id || '');
    const hasChanged = !existingId || existingId !== currentId;

    state.currentDrop = currentDrop;
    state.current_drop = currentDrop;

    if (noDropMessage) noDropMessage.style.display = 'none';
    if (dropInfo) dropInfo.style.display = 'block';

    const rewardImgUrl = currentDrop.image_url || '';

    if (typeof renderDropGameHeader === 'function') {
        renderDropGameHeader(currentDrop);
    }
    if (typeof renderDropCardLayout === 'function') {
        renderDropCardLayout(currentDrop, rewardImgUrl, hasChanged);
    }
    if (typeof renderAllProgressBars === 'function') {
        renderAllProgressBars(currentDrop.current_minutes || 0, currentDrop);
    } else if (typeof updateSingleDropDisplay === 'function') {
        updateSingleDropDisplay(currentDrop, hasChanged);
    }

    state.dropRotationIndex++;
    if (state.dropRotationIndex >= validDrops.length) {
        state.dropRotationIndex = 0;
    }
}

let isRotationRunning = false;

/**
 * Executes rotation step safely with a concurrency lock to prevent overlapping ticks.
 */
function runRotationStepSafely() {
    if (isRotationRunning) return;
    isRotationRunning = true;
    try {
        executeRotationStep();
    } catch (err) {
        console.error('Error in rotation step:', err);
    } finally {
        isRotationRunning = false;
    }
}

/**
 * Initializes drop rotation interval safely with concurrency locks.
 */
function startCombinedRotation(forceRestart = true) {
    if (!state || typeof state !== 'object') return;

    if (state.rotationTimer && !forceRestart) return;

    if (state.rotationTimer) {
        clearInterval(state.rotationTimer);
        state.rotationTimer = null;
    }

    state.rotationTimer = setInterval(runRotationStepSafely, 4000);

    if (document.querySelector('.wanted-drop-item') !== null || (Array.isArray(state.wantedItemsTree) && state.wantedItemsTree.length > 0)) {
        setTimeout(runRotationStepSafely, 0);
    }
}
