///////////////////////////////////////////////////////////////////////////////
// WANTED QUEUE MODULE ////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

// Obalení do IIFE – izolované proměnné pro throttling a uchování nejnovějšího stavu
(() => {
    let lastRenderTime = 0;
    let renderTimeout = null;
    let latestState = null; // Uchováváme čerstvá data z CustomEventu
    const RENDER_INTERVAL_MS = 1000;

    window.addEventListener('stateUpdated', (e) => {
        // Přijímáme detail z události (obsahuje wantedTree, currentDrop atd.)
        latestState = e.detail || window.state;

        const now = Date.now();
        const timeSinceLast = now - lastRenderTime;

        if (timeSinceLast >= RENDER_INTERVAL_MS) {
            if (renderTimeout) {
                clearTimeout(renderTimeout);
                renderTimeout = null;
            }
            lastRenderTime = now;
            renderWantedItems(latestState);
        } else if (!renderTimeout) {
            renderTimeout = setTimeout(() => {
                lastRenderTime = Date.now();
                renderWantedItems(latestState);
                renderTimeout = null;
            }, RENDER_INTERVAL_MS - timeSinceLast);
        }
    });
})();

/**
 * Hlavní renderovací funkce využívající data z Scoped Context parseru.
 */
function renderWantedItems(rawAppState = window.state) {
    const container = document.getElementById('wanted-items-list');
    if (!container) return;

    if (!rawAppState) return;

    // Přímý přístup k naparsovanému stromu her z getWantedQueue
    const games = getWantedQueue(rawAppState);
    if (!games.length) {
        container.innerHTML = `<p class="empty-message-small">Žádné položky k zobrazení.</p>`;
        return;
    }

    const innerHTML = games.map((game, gameIdx) => {
        const iconHTML = game.iconUrl 
            ? `<img src="${game.iconUrl}" alt="${game.name}" class="wanted-game-icon" />` 
            : '';

        let gameCurrent = 0;
        let gameRequired = 0;
        let mainGameStatus = 'queued';

        // 1. Zpracování kampaní hry
        const campaignsHTML = (game.campaigns || []).map((campaign) => {
            gameCurrent += campaign.currentMinutes || 0;
            gameRequired += campaign.requiredMinutes || 0;

            // Prioritizace stavu celé hry na základě kampaní
            if (campaign.isMining) {
                mainGameStatus = 'mining';
            } else if (campaign.isReady && mainGameStatus !== 'mining') {
                mainGameStatus = 'ready';
            } else if (campaign.hasProgress && !['mining', 'ready'].includes(mainGameStatus)) {
                mainGameStatus = 'in-progress';
            }

            const dateText = formatCampaignDates(campaign.startsAt, campaign.endsAt);
            const datesHTML = dateText 
                ? `<div class="wanted-campaign-dates">${getStatusIconSVG('upcoming')} ${dateText}</div>` 
                : '';

            // 2. Zpracování dropů v kampani
            const dropsHTML = (campaign.drops || []).map((drop) => {
                const imgHTML = drop.imageUrl 
                    ? `<img class="wanted-drop-image" src="${drop.imageUrl}" alt="${drop.name}" loading="lazy" style="width: 32px; height: 32px; object-fit: contain; flex-shrink: 0;" onerror="this.style.display='none'" />` 
                    : '';

                const rawName = String(drop.name || '').toLowerCase().replace(/^\d+[\.\)]?\s*/, '').trim();

                // Filtr a vykreslení benefitů/pillů
                const benefitsHTML = (drop.benefits || []).map(benefit => {
                    const benefitText = typeof benefit === 'string' ? benefit : benefit?.name;
                    if (!benefitText) return '';
                    const cleanBenefit = benefitText.trim().toLowerCase();
                    return (cleanBenefit && cleanBenefit !== rawName && !rawName.includes(cleanBenefit))
                        ? `<span class="wanted-benefit-pill">${benefitText}</span>`
                        : '';
                }).join('');

                // Stavový řádek dropu
                let dropStatusHTML = '';
                const isReadyToClaim = drop.canClaim || (drop.required > 0 && drop.pct >= 100);

                if (drop.isClaimed) {
                    dropStatusHTML = `
                        <span class="status-tag tag-claimed">${getStatusIconSVG('completed')} Vyzvednuto (100%)</span>
                        ${drop.required > 0 ? '<div class="wanted-drop-progress-bar"><div class="wanted-drop-progress-fill" style="width: 100%;"></div></div>' : ''}
                    `;
                } else if (isReadyToClaim) {
                    dropStatusHTML = `
                        <span class="status-tag tag-ready">${getStatusIconSVG('ready')} Připraveno (100%)</span>
                        <div class="wanted-drop-progress-bar"><div class="wanted-drop-progress-fill" style="width: 100%;"></div></div>
                    `;
                } else if (drop.required > 0) {
                    dropStatusHTML = `
                        <span class="status-tag tag-progress wanted-drop-text">${getStatusIconSVG('active')} ${drop.current} / ${drop.required} min</span>
                        <div class="wanted-drop-progress-bar">
                            <div class="wanted-drop-progress-fill" style="width: ${drop.pct}%;"></div>
                        </div>
                    `;
                }

                const dropClasses = `wanted-drop-item ${drop.isClaimed ? 'is-claimed' : ''} ${drop.canClaim ? 'can-claim' : ''}`.trim();

                return `
                    <div class="${dropClasses}"
                         data-wanted-drop-id="${drop.id}"
                         data-drop-id="${drop.id}"
                         data-drop-name="${String(drop.name || '').trim()}"
                         data-campaign-id="${campaign.id}"
                         data-required-minutes="${drop.required}">
                        ${imgHTML}
                        <div class="wanted-drop-info">
                            <span class="wanted-drop-name">${drop.displayName}</span>
                            ${benefitsHTML}
                        </div>
                        <div class="wanted-drop-status">
                            ${dropStatusHTML}
                        </div>
                    </div>
                `.trim();
            }).join('');

            return `
                <div class="${campaign.cardClasses}" data-campaign-id="${campaign.id}">
                    <div class="wanted-card-header ${campaign.statusClass}">
                        <div class="wanted-card-header-main">
                            <div class="wanted-card-title-group">
                                <a href="${campaign.url}" target="_blank" rel="noopener noreferrer" class="wanted-card-campaign-link" title="${campaign.name}">${campaign.name}</a>
                                <span class="wanted-campaign-badge">(${campaign.claimedCount}/${campaign.totalCount})</span>
                            </div>
                        </div>
                        ${datesHTML}
                        <div class="wanted-card-header-status-row">
                            <span class="wanted-status-badge status-tag ${campaign.tagClass}">${getStatusIconSVG(campaign.tagIcon)} ${campaign.tagLabel}</span>
                        </div>
                    </div>
                    <div class="wanted-card-body">
                        <div class="wanted-drops-container">
                            ${dropsHTML}
                        </div>
                    </div>
                </div>
            `.trim();
        }).join('');

        // Celkový pokrok hry v %
        const gamePct = gameRequired > 0 
            ? Math.min(100, Math.round((gameCurrent / gameRequired) * 100)) 
            : 0;

        const gameProgressBarHTML = `
            <div class="wanted-game-progress-bar">
                <div class="wanted-game-progress-fill ${mainGameStatus}" style="width: ${gamePct}%;"></div>
            </div>
        `.trim();

        return `
            <div class="wanted-game-group" data-game-name="${game.name}">
                <div class="wanted-game-header">
                    <span class="wanted-game-index">#${gameIdx + 1}</span>
                    ${iconHTML}
                    <span class="wanted-game-title">${game.name}</span>
                    <div class="wanted-game-badge-container">
                        <span class="wanted-game-time-badge" data-game-badge="${game.name}">
                            ${getStatusIconSVG('active')} ${game.timeText}
                        </span>
                        ${gameProgressBarHTML}
                    </div>
                </div>
                <div class="wanted-campaign-list">
                    ${campaignsHTML}
                </div>
            </div>
        `.trim();
    }).join('');

    // Efektivní aktualizace DOMu přes morphdom bez blikání obrázků
    morphdom(container, `<div id="wanted-items-list">${innerHTML}</div>`, {
        getNodeKey: (node) => {
            if (node.dataset) {
                if (node.dataset.gameName) return `game-${node.dataset.gameName}`;
                if (node.dataset.campaignId) return `campaign-${node.dataset.campaignId}`;
                if (node.dataset.dropId) return `drop-${node.dataset.dropId}`;
            }
            return node.id;
        },
        onBeforeElUpdated: (fromEl, toEl) => {
            if (fromEl.tagName === 'IMG' && toEl.tagName === 'IMG' && fromEl.src === toEl.src) {
                return false;
            }
            return true;
        }
    });
}

////////////////////////////////////////////////////////
// ==================== POMOCNÉ FUNKCE =================
////////////////////////////////////////////////////////

function formatCampaignDates(startIso, endIso) {
    if (!startIso || !endIso) return '';
    const start = new Date(startIso);
    const end = new Date(endIso);
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return '';
    
    const formatOpts = { day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit' };
    return `${start.toLocaleDateString(undefined, formatOpts)} – ${end.toLocaleDateString(undefined, formatOpts)}`;
}

function getStatusIconSVG(statusClass) {
    const key = String(statusClass || '').trim().toLowerCase();

    const svgCheck = `<svg class="status-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`;
    const svgBox = `<svg class="status-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M20 6h-4c0-2.21-1.79-4-4-4S8 3.79 8 6H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM12 4c1.1 0 2 .89 2 2h-4c0-1.11.9-2 2-2zM4 20V8h4v2h2V8h4v2h2V8h4v12H4z"/></svg>`;
    const svgCross = `<svg class="status-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg>`;
    const svgClock = `<svg class="status-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`;

    const icons = {
        claimed: svgCheck, completed: svgCheck, 'drop-claimed': svgCheck,
        'can-claim': svgBox, ready: svgBox, 'drop-ready': svgBox,
        expired: svgCross, 'drop-expired': svgCross,
        active: svgClock, 'drop-active': svgClock, upcoming: svgClock, 'in-progress': svgClock
    };

    return icons[key] || '';
}

4
